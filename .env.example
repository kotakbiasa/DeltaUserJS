# ==========================================
# DELTAUSERJS CONFIGURATION (.env)
# ==========================================

# --- WAJIB (REQUIRED) ---
# Token Bot Telegram dari @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# ID angka Telegram pemilik bot (cek via @userinfobot)
OWNER_ID=123456789
# Kunci enkripsi session (WAJIB, buat via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# --- TELEGRAM API (MTPROTO / USERBOT) ---
# Kredensial dari https://my.telegram.org (default resmi Telegram Android)
API_ID=2496
API_HASH=8da85b0d5bfe62527e5b244c209159c3

# --- DATABASE ---
# URI MongoDB Atlas/Lokal. KOSONGKAN jika ingin memakai database file lokal (database.json)
MONGO_URI=mongodb+srv://user:***@cluster.mongodb.net/?retryWrites=true&w=majority

# --- LOGGING ---
# ID grup/channel untuk system log (0 jika nonaktif, contoh: -1001234567890)
LOG_GROUP_ID=0
# ID topik/thread jika grup bertipe forum (0 jika bukan forum)
LOG_TOPIC_ID=0

# --- HTTP SERVER & MINI APP ---
# URL HTTPS Mini App yang didaftarkan di @BotFather
APP_URL=https://your-domain.com
HEALTH_PORT=3000
# Dev auth bypass di localhost (HANYA untuk dev lokal, jangan set true di production)
ALLOW_DEV_AUTH=false

# --- STORAGE & SECURITY ---
# Direktori state approval (WAJIB di-mount volume di Docker: /app/data)
STATE_DIR=./data
DIGITAL_STORE_PATH=./data/digital-store.json
# Izinkan eksekusi perintah shell userbot (.exec / .sh)
EXEC_ALLOWED=false
