BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
OWNER_ID=your_telegram_user_id
LOG_GROUP_ID=your_log_group_id
LOG_TOPIC_ID=your_log_topic_id
MONGO_URI=mongodb+srv://user:***@cluster.mongodb.net/?retryWrites=true&w=majority
MUSLIM_SALAT_API_KEY=your_muslimsalat_api_key
ENCRYPTION_KEY=generate-a-random-32-byte-key-here-or-let-the-app-handle-it
API_ID=your_telegram_api_id
API_HASH=your_telegram_api_hash
EXEC_ALLOWED=false

# Payment Gateway Config (optional - for subscription system)
# Midtrans
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_IS_PRODUCTION=false
# Xendit
XENDIT_API_KEY=your_xendit_api_key
XENDIT_CALLBACK_TOKEN=your_xendit_callback_token
XENDIT_CALLBACK_VA_ID=your_xendit_callback_va_id
XENDIT_IS_PRODUCTION=false
# App URL for callbacks
APP_URL=https://your-domain.com
