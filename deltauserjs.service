[Unit]
Description=DeltaUserJS - Multi-userbot Telegram Manager
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/DeltaUserJS
EnvironmentFile=/root/DeltaUserJS/.env
Environment=NODE_ENV=production
ExecStart=/root/.bun/bin/bun run src/index.ts
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deltauserjs

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/DeltaUserJS /root/logs

[Install]
WantedBy=multi-user.target