{
  "name": "delta-ubot-js",
  "version": "1.0.0",
  "description": "Multi-userbot manager using grammY for Master Bot and GramJS/teleproto for userbots",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node --no-warnings dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && tsc",
    "test": "node test/runner.js",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/menu": "^1.3.1",
    "@grammyjs/ratelimiter": "^1.2.1",
    "dotenv": "^17.4.2",
    "grammy": "^1.44.0",
    "jimp": "^1.6.1",
    "mongoose": "^9.7.1",
    "qrcode": "^1.5.4",
    "speedtest-net": "^2.2.0",
    "teleproto": "^1.227.0"
  },
  "overrides": {
    "got": "^11.8.6",
    "http-cache-semantics": "^4.1.1",
    "tar": "^7.5.16"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
