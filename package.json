{
  "name": "delta-ubot-js",
  "version": "1.0.0",
  "description": "Multi-userbot manager using grammY for Master Bot and GramJS/teleproto for userbots",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "start:prod": "pm2 start ecosystem.config.js",
    "dev": "bun --watch run src/index.ts",
    "build": "rm -rf dist && tsc",
    "test": "node test/runner.js",
    "test:unit": "node test/validation.test.js",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write src/",
    "docker:build": "docker build -t deltauserjs .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/menu": "^1.4.0",
    "@grammyjs/ratelimiter": "^1.2.1",
    "dotenv": "^17.4.2",
    "grammy": "^1.46.0",
    "jimp": "^1.6.1",
    "mongoose": "^9.9.4",
    "qrcode": "^1.5.4",
    "teleproto": "^1.229.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
