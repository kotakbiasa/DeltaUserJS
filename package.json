{
  "name": "delta-ubot-js",
  "version": "1.0.0",
  "description": "Multi-userbot manager using grammY for Master Bot and mtcute for userbots",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node --no-warnings dist/index.js",
    "start:prod": "pm2 start ecosystem.config.js",
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && npm run build:webapp",
    "build:webapp": "npm --prefix webapp run build",
    "test": "npm run test:unit && node test/runner.js",
    "test:unit": "node test/validation.test.js && node --test test/auth.test.js test/digitalStore.test.js test/customEmoji.test.js test/utils.test.js test/defineCommand.test.js test/dispatch.test.js test/security.test.js test/hardening.test.js test/apiRoutes.test.js test/dashboardSplit.test.js",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write src/",
    "diagnostics:panels": "tsx scripts/diagnostics/verify-panels.ts",
    "diagnostics:menus": "tsx scripts/diagnostics/show-menus.ts",
    "diagnostics:tags": "tsx scripts/diagnostics/debug-tags.ts",
    "docker:build": "docker build -t deltauserjs .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/ratelimiter": "^1.2.1",
    "@mtcute/convert": "^0.32.3",
    "@mtcute/dispatcher": "^0.32.3",
    "@mtcute/node": "^0.32.3",
    "dotenv": "^17.4.2",
    "grammy": "^1.46.0",
    "jimp": "^1.6.1",
    "mongoose": "^9.9.4",
    "qrcode": "^1.5.4",
    "tgcalls-js": "github:kotakbiasa/tgcalls-js",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
